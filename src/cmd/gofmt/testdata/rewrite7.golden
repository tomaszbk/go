//gofmt -r=fun(x...)->Fun(x)


// Rewriting of calls must take the ... (ellipsis)
// attribute for the last argument into account.

package p

func fun(x []int) {}

func g(x []int) {
	fun(x) // -r='fun(x...)->Fun(x)' should not rewrite this
	Fun(x) // -r='fun(x...)->Fun(x)' should rewrite this to Fun(x)
}
