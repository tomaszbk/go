// Test case for go.dev/issue/3106: Better synchronization of
// parser after certain syntax errors.

package main

func f() {
	var m Mutex
	c := MakeCond(&m)
	percent := 0
	const step = 10
	for i := 0; i < 5; i++ {
		go func() {
			for {
				// Emulates some useful work.
				time.Sleep(1e8)
				m.Lock()
				// In Gon, "if" may start a conditional expression, which
				// can be the operand of defer: the errors are reported in
				// that construct, and parsing resumes after it.
				defer
				if percent == 100 {
					m.Unlock()
					break /* ERROR "conditional expression branch must be a single expression" */
				} /* ERROR HERE "expression in defer must be function call" */
				percent++
				if percent % step == 0 {
					//c.Signal()
				}
				m.Unlock()
			}
		}()
	}
	for {
		m.Lock()
		if percent == 0 || percent % step != 0 {
			c.Wait()
		}
		fmt.Print(",")
		if percent == 100 {
			m.Unlock()
			break
		}
		m.Unlock()
	}
}
